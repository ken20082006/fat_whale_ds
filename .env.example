# 複製為 .env 後填入實際值。.env 已被 .gitignore 排除。

# ── 必填 ──────────────────────────────────────────────
# 向 @BotFather 申請。/setprivacy 必須選 Disable，否則群組引用鏈無法回溯。
FW_TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter API key
FW_OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 管理員的 Telegram user id，逗號分隔。可用 @userinfobot 查詢。
# 只有管理員能把本 bot 加入群組，其他人加的一律自動退出。
FW_ADMIN_USER_IDS=123456789

# 邀請碼有效期（秒）。預設 300 秒，過期即失效。
FW_INVITE_TTL_SECONDS=300

# ── 模型 ──────────────────────────────────────────────
FW_MODEL=deepseek/deepseek-v4.1-flash
# 處理圖片用的模型，**必須具備視覺能力**
FW_MODEL_VISION=deepseek/deepseek-v4.1-flash
# 摘要、壓縮等內部工作用的模型，建議用便宜的非思考版
FW_MODEL_UTILITY=deepseek/deepseek-v4.1-flash

# 深度思考。deepseek-v4.1-flash 預設會做推理，而推理 token 以輸出計價，
# 且會佔用回覆額度。實測關閉後單次費用約降為四分之一，閒聊完全夠用。
# 使用者可用 /think 個別開啟。
#
# 這個值是**降級用的後備**：使用者沒指定 /think 時，由下面的決策模型逐則
# 判斷；決策模型不可用時才退回這裡。
FW_REASONING_ENABLED=false

# ── 決策模型（Jev）────────────────────────────────────
# 在呼叫主模型前，用一次呼叫同時判斷三件事：這一則要直接答、要推理、要
# 搜尋、還是要搜尋加推理；要思考到幾深；演出要放開到幾成。
#
# TypeSafe 的 Jev **不是聊天模型** —— 它不生成文字，只回傳校准過的機率，
# 走獨立端點，且**輸出免費**（只有輸入計費，實測約 $0.00002/次）。
#
# 為什麼不能讓主模型自己決定：它同時想回答、又得先決定要不要做其他事，
# 有利益衝突，最後幾乎必然選擇直接回答。這正是舊的 [[搜尋:...]] 標記
# 機制失敗的原因。交給一個只做決策、不生成文字的模型就沒有這個問題。
FW_DECISION_ENABLED=true
# FW_DECISION_MODEL=typesafe/jev-1.13
# 它擋在主回覆前面，逾時要短 —— 等太久不如直接降級。
# FW_DECISION_TIMEOUT_SECONDS=8
# 判斷附帶的信心值低於這個就當作沒判斷，退回後備。分布很平的時候
# （實測見過 0.23）不該硬選一個。
# FW_DECISION_MIN_CONFIDENCE=0.35
# 判斷要看幾多則上文。太少的話短追問會失真 ——「duo呢」單獨看只是三個字的
# 片段，判斷成「直接答」；帶上「上一句問緊型號」之後才會判斷成「要搜尋」。
# 實測 0 則 direct、2 則以上 search。但 2 則並不總是夠，所以留一點餘裕。
# FW_DECISION_CONTEXT_MESSAGES=4
# 判斷說要思考時，max_tokens 放寬幾倍。推理 token 會吃掉這個額度，
# 用完 content 會變 null（使用者收到「本鯨想得太久」）。
# FW_REASONING_BUDGET_LOW=1.2
# FW_REASONING_BUDGET_HIGH=1.8
# 記憶抽取的前置閘：Jev 說這段對話沒有值得記的事實時，跳過那次抽取呼叫。
# 門檻刻意設得低 —— 漏記一則正確的事實，比多花一次便宜呼叫嚴重得多。
# FW_MEMORY_DECISION_THRESHOLD=0.25

# ── 媒體 ──────────────────────────────────────────────
# 縮圖的長邊上限。只在原圖比它大時才縮，不會放大。
#
# 1568 而不是 1024：Telegram 給的照片最大通常約 1280 邊，設 1024 等於每一張
# 都被縮一次；設 1568 則一般不觸發縮圖，送的是原樣。代價是 image token 約為
# 像素數 ÷ 750 —— 1280×960 由約 1 050 升至約 1 640。
# 貼圖與影片的縮圖本身就更小，調高這個值幫不到它們。
FW_IMAGE_MAX_EDGE=1568
# 單一媒體的下載上限。量的是實際下載的位元組數，不是原始素材的大小 ——
# 靜態圖片與貼圖縮圖都遠低於這個值。
FW_IMAGE_MAX_BYTES=8388608

# ── 影片與動圖：一律外包 ──────────────────────────────
# **沒有抽格這回事了。** 主模型只看得懂靜態圖，而抽幾個定格看不出連續動作、
# 節奏與字幕變化，還會讓它以為自己看過整段、講出半真半假的描述。
#
# 所以影片與動圖一律交給吃得了影片的模型看完，拿一段文字解說回來。
# 外包不成就是**沒有這個媒體**，並把原因講出來 —— 不抽格充數。
# 所以本專案不需要 ffmpeg。
#
# **揀模型時，「本地區用得到」同「真係睇得到」都要驗，唔可以睇型號名。**
# 換過兩次都係實測才發現問題：
#   1. google/gemini-3.5-flash-lite 對香港 IP 回 403（連純文字都 403）。
#      而且失敗係靜默的：describe_video 會 catch 例外再回 None，結果係
#      「所有影片都冇描述」而唔會有人發現。
#   2. xiaomi/mimo-v2.6-flash 收 mp4、夠快，但唔夠準 —— 實測《古惑仔》
#      烏鴉反枱嗰段，佢講成「一名女子……她將圓桌掀翻」，主角性別都錯。
# 兩者嘅 input_modalities 都列有 video —— **架構欄位只證明「食得落」，
# 唔證明「睇得清」**，所以要用真實片驗。
#
# bytedance-seed/seed-2.0-mini：實測 4 條片都準（捉到性別、動作、字幕原文），
# 每條約 5–7 秒、$0.0003–0.0005。
FW_VIDEO_DELEGATE_MODEL=bytedance-seed/seed-2.0-mini

# **真 GIF（image/gif）要交給另一個模型，而且要用 image_url。**
# 這不是偏好問題，是能力問題：實測 10 個收片模型，真 GIF 只有 xiaomi 睇得到
# （要經 image_url；經 video_url 係 HTTP 400）。
#
# 更麻煩係其他人唔會報錯，而係用兩種都會污染快取嘅方式失敗 ——
# seed-1.6-flash 憑空作一個完全唔同嘅場景、seed-2.0-mini 回「請提供具體內容」，
# 兩者都會被當成正常描述寫入 media_notes 並永久保存。
# 而 GIF 唔係邊緣案例：實測快取裡 10 條全部係 animation。
FW_GIF_DELEGATE_MODEL=xiaomi/mimo-v2.6-flash

# **解說會按媒體的穩定識別碼快取。** 這不只是省錢，也是為了一致：
# 同一條片再傳，外包模型會給出唔同的描述（實測同一條 GIF 三次得到
# 「鯨魚噴水」「掀檯」「街頭窄巷」）。貼圖更是同一張反覆出現，而貼圖的
# file_unique_id 永久穩定 —— **睇一次就夠，之後免費**。

# **影片輸入按秒計費**：Gemini 預設每秒抽一格、每格約 260 token，所以
# 300 秒約 78,000 token ≈ $0.023。上限 300 秒是有意識的取捨：一條 5 分鐘
# 片約兩仙美元。超過就**不做外包，而且會講出來**（「影片長過 300 秒，
# 外包不划算」）—— 使用者才知道我們沒看過，而不是以為整段都被看過了。
FW_VIDEO_DELEGATE_MAX_SECONDS=300

# 大小上限跟 token 無關，是為了請求本身：base64 脹約三分之一，10MB 的片
# 變成約 13MB 的 JSON，而 Gemini 的 inline 上限是 20MB —— 留一點餘量。
#
# 它往往比長度上限更早觸發：一條 5 分鐘的 720p 片通常遠超 10MB。所以
# 「太長」與「太大」的訊息分開講，使用者才知是哪一種。
FW_VIDEO_DELEGATE_MAX_BYTES=10485760

# 解說長度。**要夠長才講得具體** —— 限死在「四句以內」時，外包模型只講得出
# 大意，動作、次序、字幕都交代不到。它只出現在當前這一則的提示裡（不落庫），
# 所以放寬不會令對話歷史膨脹。
#
# MAX_TOKENS 要**放得很闊**：這個端點強制推理，推理 token 會吃掉這個額度。
# 實測一條 5–6 秒的片，推理佔 780–930 token、正文約 250 字，合共約 1150 ——
# 設 1200 會在稍長的片上「想」到爆額、正文變空。
# FW_VIDEO_DELEGATE_MAX_TOKENS=4000
# FW_VIDEO_DELEGATE_MAX_CHARS=900

# 一輪最多外包幾條「引用串裡的」影片。每條最貴約兩仙美元，所以預設只做
# 最近一條 —— 一串裡有四條片就是 $0.09，不該默默發生。
# FW_VIDEO_DELEGATE_CHAIN_LIMIT=1

# ── 思考過程（beta）──────────────────────────────────
# 把模型的思考過程貼出來，收在一個「撳一下展開」的引用塊裡面。
#
# **beta，預設關。** 關著的時候完全不會出現，原有行為一模一樣。
# 開啟之後仍然只有**推理真的開過**的回覆才有內容可貼 —— 推理沒開就沒有
# 思考過程（見 /think，以及 Jev 的逐則判斷）。
#
# 平常不必改這裡，直接在 Telegram 用：
#   /tune set why on     開啟（即時生效、重啟仍在）
#   /tune set why off    關閉
#
# 思考內容是模型自言自語的原文，可能覆述到人設或系統提示，所以貼之前會
# 過一次 find_system_leak，命中就整段不貼。它也不會落庫。
# FW_SHOW_REASONING=false
# FW_SHOW_REASONING_MAX_CHARS=1500

# ── 路徑 ──────────────────────────────────────────────
FW_PERSONA_FILE=config/persona.md
FW_DB_PATH=data/fatwhale.db
FW_LOG_DIR=logs

# ── Session 參數（可留空用預設）──────────────────────
# 下面列的是 settings.py 的實際預設值，不是建議值 —— 想改才需要寫進 .env。
# FW_WINDOW_TURNS=30
# FW_COMPACT_TRIGGER_TOKENS=12000
# FW_SUMMARY_MAX_TOKENS=800
# FW_IDLE_RESET_MINUTES=480
# FW_PRIVATE_REPLY_MAX_TOKENS=2400
# FW_GROUP_REPLY_MAX_TOKENS=1100
# FW_GROUP_THREAD_TTL_MINUTES=720
# 「管理員在不在這個群組」的快取秒數
# FW_GROUP_MEMBERSHIP_TTL_SECONDS=300

# ── 聯網 ──────────────────────────────────────────────
# 這裡是**基底**值。管理員可以在 Telegram 用 /tune 覆寫，改完立即生效、
# 重啟仍在；/tune reset 會還原成下面的值。搜尋這種要憑感覺調的參數
# 不必每次改檔案再重啟。
#
# 搜尋積極程度：off / trigger / auto / always
#   trigger 只認明講的（「上網查」「search 一下」）
#   auto    交給判斷（見下面的決策模型）
#   always  每則都搜，最準但也最慢
# FW_SEARCH_MODE=auto
#
# **兩條搜尋路徑，只有需要「保證會搜」時才走後者：**
#
#   伺服器端工具（其餘情況）—— 模型自己決定搜幾次、用什麼查詢，拿到的是
#     原文片段。實測一次請求會搜 2–4 次，所以「先撈一次冇，再換個講法撈」
#     做得到 —— 小眾名詞需要這個。
#
#   web 外掛（always 與 /search）—— 保證至少搜一次，但查詢由引擎從對話
#     推導、模型無權指定，而且拿到的是摘要、只搜一次。
#
#   伺服器端工具沒有 tool_choice、官方也沒記載可強制，所以無法用參數逼它搜 ——
#   這就是「保證會搜」只能走外掛的原因。
#
# 引擎選項：parallel（便宜）、exa（官方預設）、perplexity、firecrawl
# 實測同一題：exa $0.0083、parallel $0.0057、parallel+turbo $0.0018、parallel+fast $0.0013
# FW_SEARCH_ENGINE=parallel
# 引擎自身的分級，與上面的 FW_SEARCH_MODE 是兩回事。
# fast 對 exa 與 parallel 都有效，留空則用引擎預設（較貴）
# FW_SEARCH_ENGINE_MODE=fast
# 判斷說「一個明確事實就夠」／「小眾冷門、撈少會漏」時分別撈幾條。
# 中間值就是上面的 FW_SEARCH_MAX_RESULTS。
#
# **這三個都有硬上限 20，超過會令每一次搜尋請求都 HTTP 400。**
# 官方文件的範圍是「1–25（Perplexity 係 1–20）」，這裡取最低嗰個 ——
# 引擎本身也可以換，取最低就永遠不會撞到上限。
# FW_SEARCH_RESULTS_QUICK=3
# FW_SEARCH_RESULTS_THOROUGH=10
# 伺服器端工具一次請求的結果總上限。**限結果不限請求** —— 這個參數只轉發
# 給部分引擎，其餘會忽略，真正的次數上限約 3 次。官網沒有寫上限
# （未指定時預設 50），所以這裡只設下限。
# FW_SEARCH_MAX_TOTAL_RESULTS=15
# 一則訊息最多讀幾個對方貼的連結
# FW_FETCH_MAX_URLS=3

# 告訴模型「今天」是哪一天，它才判斷得出「最新」是相對什麼時候。
# 香港沒有日光節約，固定位移即可。
# FW_TIMEZONE_OFFSET_HOURS=8
# FW_TIMEZONE_LABEL=香港時間

# ── 長期記憶 ──────────────────────────────────────────
# 自動從對話中抽取關於使用者的事實，不必手動 /remember
# FW_AUTO_MEMORY=true
# 單一場合的筆記硬上限
# FW_NOTES_PER_SCOPE_MAX=60
# 累積到這個數量就觸發整理，把零碎筆記合併壓縮
# FW_NOTES_CONSOLIDATE_THRESHOLD=25
# 整理後希望留下的則數
# FW_NOTES_CONSOLIDATE_TARGET=12

# ── 群組概況 ──────────────────────────────────────────
# 每個群一則「這個群體本身」的概況（主題、氣氛、慣例、近期話題），與
# 個人筆記分開存。筆記每一則都屬於某個人，記不到「群組層面的規矩」。
#
# 素材限於機器人**親自參與過的交流**（被 @ 或被回覆的那些）。它在群組裡
# 旁觀到的其他閒聊不會被沉澱成永久記錄 —— 那些只在 group_cache 留 72 小時。
FW_GROUP_PROFILE_ENABLED=true
# 累積夠幾則新交流才更新一次。
# FW_GROUP_PROFILE_MIN_EXCHANGES=8
# FW_GROUP_PROFILE_MAX_EXCHANGES=60
# 距上次更新至少隔幾小時 —— 太頻繁只會讓概況跳來跳去。
# FW_GROUP_PROFILE_MIN_HOURS=6
# 長度上限。刻意短 —— 每次群組回覆都會進 system prompt。
# FW_GROUP_PROFILE_MAX_CHARS=600

# ── 節流 ──────────────────────────────────────────────
# FW_DEBOUNCE_SECONDS=1.5
# FW_RATE_PER_MINUTE=20

# ── 保存期限 ──────────────────────────────────────────
# FW_HISTORY_RETENTION_DAYS=30
# FW_GROUP_CACHE_RETENTION_HOURS=72

# ── 維護模式 ──────────────────────────────────────────
# 遷移或改版期間用。開啟之後，群組被指名也**不做任何真工作** ——
# 不叫模型、不查引用串、不看片、不抽記憶 —— 只回一句人設語氣的「調整緊」。
#
# 為什麼要這個：改版期間群組是 live 的，但答案會唔準。與其靜靜哋答錯，
# 不如老實講調整緊。
#
# **私聊完全不受影響。** 只影響群組的回應路徑，所以你自己照樣可以私聊使用。
#
# 平常不必改這裡 —— 直接在 Telegram 打 `/tune set maintenance on` 即時開，
# 遷移完 `/tune reset maintenance` 還原，兩者都不必重啟容器。
# 這一行只是給「連容器都還沒起來就要開」的情況用的。
# FW_MAINTENANCE_MODE=false
# 同一個群在這段時間內只出一則通知。通知不是答案，整個群每個人 @ 一次
# 就會洗版。純記憶體，重啟歸零。
# FW_MAINTENANCE_NOTICE_COOLDOWN_SECONDS=600
