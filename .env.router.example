# Router 嘅設定。複製一份做 `.env.router` 再填。
#
# ⚠️ 呢個檔唔入 git（見 .gitignore）。同大肥鯨嗰個 `.env` 分開 ——
#    Router 用嘅 bot token 唔同（測試期用 beta bot），仲要 Hermes 條 key。

# 邊隻 bot。測試期用 beta bot，唔好填大肥鯨嗰條 ——
# 同一個 token 兩個 process 一齊 polling 會 409。
FW_TELEGRAM_BOT_TOKEN=

# Hermes API server。睇 C:\ds\hermes_ds\data\.env 嘅 API_SERVER_KEY。
FW_HERMES_URL=http://127.0.0.1:8642
FW_HERMES_KEY=

# Router 已經唔自己打模型（交晒畀 Hermes），但 Settings 仍然要求呢個欄位。
# 是但填一個非空值，或者填返你真嘅 key。
FW_OPENROUTER_API_KEY=

# 管理員。大肥鯨嘅規則係「管理員在唔在個群」，所以呢個一定要填。
FW_ADMIN_USER_IDS=

# 分開嘅資料庫同日誌 —— 唔好同大肥鯨撞。
FW_DB_PATH=data/router.db
FW_LOG_DIR=logs
